# Copy this file to .env.local and fill in every value.
# .env.local is git-ignored — never commit real keys.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The id (uuid) of the psychologist's row in the `psychologists` table
NEXT_PUBLIC_PSYCHOLOGIST_ID=00000000-0000-0000-0000-000000000000

# Time zone the psychologist works in. All availability hours and
# booking times are interpreted in this zone (Kosovo uses Europe/Belgrade).
NEXT_PUBLIC_CLINIC_TIMEZONE=Europe/Belgrade

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be on a domain verified in Resend (onboarding@resend.dev works for testing only)
BOOKING_FROM_EMAIL=bookings@yourdomain.com

# Public URL of the site, used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/cron/send-reminders (Vercel sets this automatically)
CRON_SECRET=generate-a-long-random-string
